{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.dev/contracts/runner/v1/auth.schema.json",
  "title": "Authentication scheme",
  "description": "How a secret value is set on a request, from the closed set of schemes the proxy implements. bearer sets Authorization: Bearer and the value. header sets the header in header to the value. basic sets Authorization: Basic with the username in username and the value as the password.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scheme"],
  "properties": {
    "scheme": {"enum": ["bearer", "header", "basic"]},
    "header": {"type": "string", "maxLength": 64, "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"},
    "username": {"type": "string", "minLength": 1, "pattern": "^[^:\\s]+$"}
  },
  "allOf": [
    {"if": {"properties": {"scheme": {"const": "header"}}}, "then": {"required": ["header"]}, "else": {"not": {"required": ["header"]}}},
    {"if": {"properties": {"scheme": {"const": "basic"}}},
     "then": {"required": ["username"]}, "else": {"not": {"required": ["username"]}}}
  ]
}
