{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.dev/contracts/runner/v1/events/run.refused.schema.json",
  "title": "dev.qory.run.refused",
  "description": "The run did not start after the ping. Emitted in place of dev.qory.run.started when the server closes the run before it starts, with a signed 410 run_closed: the run's first event after the ping, heartbeats aside, and its last, recorded in the file sink alone. Events carry names and ids alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code"],
  "properties": {
    "code": {"description": "Why the run did not start: a refusal code of the runner, of qory, or of the server, the one a signed answer's body contained.", "type": "string", "enum": ["bad_request", "unsupported_contract_version", "invalid_request", "rate_limited", "unavailable", "key_invalid", "key_limit", "instance_limit", "secrets_not_allowed", "run_closed", "run_configuration_superseded", "run_connections_invalid", "run_secrets_conflict", "run_secrets_expired", "secrets_endpoint_missing", "envelope_signature_invalid", "apiary_public_key_missing", "answer_unsigned", "unauthorized", "labels_changed", "server_needs_wall", "mount_contains_runner_files", "mount_mode_conflict", "mount_shared_with_run", "mount_through_link", "engine_unreachable", "mount_contains_credential_files", "run_configuration_invalid", "fetch_failed", "run_configuration_digest_mismatch", "connection_needs_wall", "connection_duplicate", "connection_secret_unknown", "connection_host_invalid", "connection_host_public_suffix", "connection_header_reserved", "connection_host_conflict", "runtime_connection_duplicate", "runtime_secret_choice", "runtime_secret_missing", "runtime_secret_conflict", "integration_missing", "integration_role_missing", "integration_way_not_allowed", "integration_description_invalid", "integration_source_mismatch", "integration_name_mismatch", "integration_version_mismatch", "integration_argument_not_allowed", "integration_settings_not_allowed", "integration_hosts_exceeded", "integration_settings_invalid", "integration_settings_too_large", "integration_failed", "tool_not_started", "tool_unknown", "tool_invalid", "tool_host_denied", "image_unknown", "image_invalid", "start_failed", "secret_value_id_missing", "secret_unresolved", "secret_hosts_exceeded", "secret_value_invalid", "secret_sealed_invalid", "secret_sealed_expired", "secret_sealed_mismatch", "variable_reserved", "placeholder_conflict"]},
    "names": {"description": "The names the refusal concerns, never a value: variables, tools, images, paths, an earlier or another run's id, or the names a server's coded refusal lists.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"description": "The HTTP status of the answer, when the code came from the server, and with fetch_failed when the fetch answered.", "type": "integer", "minimum": 100, "maximum": 599}
  }
}
