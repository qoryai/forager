{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.dev/contracts/forager/v1/events/runtime.subagent_started.schema.json",
  "title": "dev.qory.runtime.subagent_started",
  "description": "The runtime spawned a subagent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "agent_id", "agent_type"],
  "properties": {
    "session_id": {"description": "The runtime's session identifier.", "type": "string", "minLength": 1},
    "session": {"description": "The number of the session whose runtime wrote the record, from 1: the session of its dev.qory.session.started.", "type": "integer", "minimum": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "agent_type": {"type": "string", "minLength": 1}
  }
}
