{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.dev/contracts/forager/v1/events/session.started.schema.json",
  "title": "dev.qory.session.started",
  "description": "The runtime opened its session.",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "source"],
  "properties": {
    "session_id": {"description": "The runtime's own session identifier.", "type": "string", "minLength": 1},
    "source": {"description": "How the session started, in the runtime's words: startup, resume.", "type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "cwd": {"type": "string", "minLength": 1},
    "agent_id": {"description": "The subagent this happened in, when it did not happen in the main conversation.", "type": "string", "minLength": 1},
    "agent_type": {"description": "The subagent's type, or the agent the session was started as.", "type": "string", "minLength": 1}
  }
}
