              "const": "https://qory.dev/contracts/forager/v1/events/run.resized.schema.json"
            },
            "data": {
              "$ref": "events/run.resized.schema.json"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "dev.qory.run.egress"
            },
            "dataschema": {
              "const": "https://qory.dev/contracts/forager/v1/events/run.egress.schema.json"
            },
            "data": {
              "$ref": "events/run.egress.schema.json"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "dev.qory.run.policy_applied"
            },
            "dataschema": {
              "const": "https://qory.dev/contracts/forager/v1/events/run.policy_applied.schema.json"
            },
            "data": {
              "$ref": "events/run.policy_applied.schema.json"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "dev.qory.run.exited"
            },
            "dataschema": {
              "const": "https://qory.dev/contracts/forager/v1/events/run.exited.schema.json"
            },
            "data": {
              "$ref": "events/run.exited.schema.json"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "dev.qory.run.refused"
            },
            "dataschema": {
              "const": "https://qory.dev/contracts/forager/v1/events/run.refused.schema.json"
            },
            "data": {
              "$ref": "events/run.refused.schema.json"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "dev.qory.session.started"
            },
            "dataschema": {
              "const": "https://qory.dev/contracts/forager/v1/events/session.started.schema.json"
            },
            "data": {
              "$ref": "events/session.started.schema.json"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "dev.qory.session.exited"
