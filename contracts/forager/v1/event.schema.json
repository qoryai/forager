            },
            "data": {
              "$ref": "events/run.built.schema.json"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "dev.qory.runtime.started"
            },
            "dataschema": {
              "const": "https://qory.dev/contracts/forager/v1/events/runtime.started.schema.json"
            },
