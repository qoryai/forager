{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.dev/contracts/forager/v1/event.schema.json",
  "title": "Event",
  "description": "One event Forager emits: a CloudEvents 1.0 event in the JSON format, with the attributes this contract fixes and the data of its type. One per line in events.jsonl; the members of a batch.",
  "allOf": [
    {
      "$ref": "cloudevents.schema.json"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specversion",
        "id",
        "source",
        "type",
        "subject",
        "time",
        "sequence",
        "dataschema",
        "data"
      ],
      "properties": {
        "specversion": {
          "const": "1.0"
        },
        "id": {
          "description": "A UUID, unique per event. A receiver deduplicates on it.",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source": {
          "description": "urn:qory:run: followed by the run id. One run is one source, so sequence orders within it.",
          "type": "string",
          "pattern": "^urn:qory:run:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "dev.qory.run.registered",
            "dev.qory.run.started",
            "dev.qory.run.heartbeat",
            "dev.qory.run.log",
            "dev.qory.run.resized",
            "dev.qory.run.egress",
            "dev.qory.run.policy_applied",
            "dev.qory.run.exited",
            "dev.qory.run.refused",
            "dev.qory.session.started",
            "dev.qory.session.exited",
            "dev.qory.run.step_started",
            "dev.qory.run.step_exited",
            "dev.qory.run.built",
            "dev.qory.runtime.started",
            "dev.qory.runtime.prompt_submitted",
            "dev.qory.runtime.tool_started",
            "dev.qory.runtime.tool_finished",
            "dev.qory.runtime.tool_failed",
            "dev.qory.runtime.turn_finished",
            "dev.qory.runtime.turn_failed",
            "dev.qory.runtime.subagent_started",
            "dev.qory.runtime.subagent_finished",
            "dev.qory.runtime.message",
            "dev.qory.runtime.notification",
            "dev.qory.runtime.ended",
            "dev.qory.runtime.result"
          ]
        },
        "subject": {
          "description": "The run id, a UUID version 7. The same id as in source; a receiver keys the run on it.",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "time": {
          "description": "Forager's clock, RFC 3339, UTC.",
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "sequence": {
          "description": "The Forager-assigned order of this event within the run: a decimal, zero-padded to ten digits, starting at 0000000001, contiguous.",
          "type": "string",
          "pattern": "^[0-9]{10}$"
        },
        "dataschema": {
          "description": "The schema of data: events/<type without the dev.qory. prefix>.schema.json under this contract's base.",
          "type": "string",
          "format": "uri"
        },
        "datacontenttype": {
          "const": "application/json"
        },
        "data": {
          "type": "object"
        }
      }
    },
    {
      "description": "The data of each type validates against that type's schema, the one dataschema points to.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "dev.qory.run.registered"
            },
            "dataschema": {
              "const": "https://qory.dev/contracts/forager/v1/events/run.registered.schema.json"
            },
            "data": {
              "$ref": "events/run.registered.schema.json"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "dev.qory.run.started"
            },
            "dataschema": {
              "const": "https://qory.dev/contracts/forager/v1/events/run.started.schema.json"
            },
            "data": {
              "$ref": "events/run.started.schema.json"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "dev.qory.run.heartbeat"
            },
            "dataschema": {
              "const": "https://qory.dev/contracts/forager/v1/events/run.heartbeat.schema.json"
            },
            "data": {
              "$ref": "events/run.heartbeat.schema.json"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "dev.qory.run.log"
