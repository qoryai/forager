{
  "version": 1,
  "runtimes": [
    {
      "name": "claude",
      "title": "Claude Code",
      "reserves": [],
      "denies": [
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_BEDROCK_BASE_URL",
        "ANTHROPIC_BEDROCK_MANTLE_BASE_URL",
        "ANTHROPIC_VERTEX_BASE_URL",
        "ANTHROPIC_FOUNDRY_BASE_URL",
        "ANTHROPIC_AWS_BASE_URL",
        "ANTHROPIC_CUSTOM_HEADERS",
        "CLAUDE_CODE_USE_BEDROCK",
        "CLAUDE_CODE_USE_VERTEX",
        "CLAUDE_CODE_USE_FOUNDRY",
        "CLAUDE_CODE_USE_ANTHROPIC_AWS",
        "CLAUDE_CODE_SHELL",
        "CLAUDE_CODE_SHELL_PREFIX",
        "CLAUDE_ENV_FILE",
        "CLAUDE_CONFIG_DIR",
        "CLAUDE_CODE_CLIENT_CERT",
        "CLAUDE_CODE_CLIENT_KEY",
        "CLAUDE_CODE_CERT_STORE",
        "CLAUDE_CODE_PLUGIN_DIRS",
        "CLAUDE_RELAUNCH_SESSION_ADD_DIRS",
        "CLAUDE_CODE_PLUGIN_SEED_DIR",
        "CLAUDE_CODE_PLUGIN_CACHE_DIR",
        "CLAUDE_CODE_MANAGED_SETTINGS_PATH"
      ],
      "credential_files": [
        "~/.claude/.credentials.json"
      ],
      "declares": [],
      "one_of": [],
      "model": {
        "formats": [
          "anthropic-messages"
        ],
        "model": {
          "flag": "--model"
        },
        "effort": {
          "run": {
            "flag": "--effort",
            "values": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          },
          "agent": {
            "frontmatter": "effort",
            "values": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          }
        },
        "endpoint": {
          "variable": "ANTHROPIC_BASE_URL"
        },
        "keys": [
          {
            "format": "anthropic-messages",
            "auth": {
              "scheme": "header",
              "header": "x-api-key"
            },
            "variable": "ANTHROPIC_API_KEY"
          },
          {
            "format": "anthropic-messages",
            "auth": {
              "scheme": "bearer"
            },
            "variable": "ANTHROPIC_AUTH_TOKEN"
          },
          {
            "format": "anthropic-messages",
            "auth": {
              "scheme": "bearer",
              "oauth": true
            },
            "variable": "CLAUDE_CODE_OAUTH_TOKEN"
          }
        ],
        "overrides": [
          "ANTHROPIC_MODEL",
          "ANTHROPIC_DEFAULT_MODEL",
          "ANTHROPIC_DEFAULT_OPUS_MODEL",
          "ANTHROPIC_DEFAULT_SONNET_MODEL",
          "ANTHROPIC_DEFAULT_HAIKU_MODEL",
          "ANTHROPIC_DEFAULT_FABLE_MODEL",
          "ANTHROPIC_SMALL_FAST_MODEL",
          "CLAUDE_CODE_SUBAGENT_MODEL",
          "CLAUDE_CODE_SUBAGENT_MODEL_FORCE",
          "CLAUDE_CODE_WORKFLOW_SUBAGENT_MODEL",
          "CLAUDE_CODE_AUTO_MODE_MODEL",
          "CLAUDE_CODE_EFFORT_LEVEL",
          "CLAUDE_CODE_SUBAGENT_EFFORT",
          "CLAUDE_CODE_EXTRA_BODY"
        ]
      },
      "fixed": {
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
        "CLAUDE_CODE_MAX_RETRIES": "15"
      },
      "egress_hosts": [
        "api.anthropic.com"
      ],
      "resume": {
        "prefix": "~/.claude/projects/",
        "path": "~/.claude/projects/{cwd_slug}/{session_id}.jsonl"
      }
    },
    {
      "name": "codex",
      "title": "Codex",
      "reserves": [],
      "denies": [
        "OPENAI_BASE_URL",
        "CODEX_AUTHAPI_BASE_URL",
        "CODEX_AGENT_IDENTITY_AUTHAPI_BASE_URL",
        "CODEX_AGENT_IDENTITY_JWKS_BASE_URL",
        "CODEX_APP_SERVER_CHATGPT_BASE_URL",
        "CODEX_CLOUD_TASKS_BASE_URL",
        "CODEX_OSS_BASE_URL",
        "CODEX_OSS_PORT",
        "CODEX_REFRESH_TOKEN_URL_OVERRIDE",
        "CODEX_REVOKE_TOKEN_URL_OVERRIDE",
        "CODEX_EXEC_SERVER_URL",
        "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
        "CODEX_API_KEY",
        "CODEX_ACCESS_TOKEN",
        "CODEX_CA_CERTIFICATE",
        "CODEX_HOME",
        "CODEX_SQLITE_HOME"
      ],
      "credential_files": [],
      "declares": [],
      "one_of": [],
      "model": {
        "formats": [
          "openai-responses"
        ],
        "model": {
          "flag": "--model"
        },
        "effort": {
          "run": {
            "setting": "model_reasoning_effort",
            "values": [
              "none",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          }
        },
        "endpoint": {
          "setting": "model_providers.qory.base_url"
        },
        "keys": [
          {
            "format": "openai-responses",
            "auth": {
              "scheme": "bearer"
            },
            "variable": "OPENAI_API_KEY"
          },
          {
            "format": "openai-responses",
            "auth": {
              "scheme": "bearer",
              "oauth": true
            },
            "variable": "OPENAI_API_KEY"
          }
        ]
      },
      "fixed": {},
      "egress_hosts": []
    }
  ]
}
